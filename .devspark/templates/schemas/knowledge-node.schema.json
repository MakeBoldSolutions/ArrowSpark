{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bsw-devspark.bswhive.com/schemas/knowledge-node.schema.json",
  "title": "BSW.DevSpark Current Knowledge Node",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "enum": [
        "authoritative-reference",
        "engineering-pattern",
        "reference-data",
        "operations-runbook",
        "research-or-context",
        "architecture",
        "governance",
        "governance-decision",
        "entity-layer"
      ],
      "description": "Use 'entity-layer' for docs under .knowledge/entities/<id>/ and set `layer` for the specific layer. Use 'governance-decision' for docs under .knowledge/governance/decisions/."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": ["architecture", "business", "integration", "operations", "pattern", "plan"],
      "description": "Entity-layer classification for docs under .knowledge/entities/<id>/. Optional — absent for non-entity knowledge (governance, reference)."
    },
    "source_of_truth": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "Repo-relative paths this doc describes. Each must exist; required whenever `layer` is set."
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "description": "Date this doc was last confirmed to match source_of_truth. Required whenever `layer` is set."
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "appliesTo": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "(?:^|/)\\.devspark\\.work/specs/|(?:^|/)(?:FR-|T[0-9]{3}|spec[- _]?[0-9])"
        }
      }
    },
    "constrains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "description": "Required for type 'governance-decision': the entity ids this decision constrains. Each entity must carry a reciprocal `constrained_by` pointer."
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "anyOf": [
          { "required": ["status"] },
          { "required": ["lifecycle"] },
          { "required": ["supersedes"] },
          { "required": ["superseded-by"] },
          { "required": ["replaced"] },
          { "required": ["obsolete"] }
        ]
      }
    },
    {
      "if": { "properties": { "type": { "const": "entity-layer" } }, "required": ["type"] },
      "then": { "required": ["layer", "source_of_truth", "last_verified"] }
    },
    {
      "if": { "properties": { "type": { "const": "governance-decision" } }, "required": ["type"] },
      "then": { "required": ["constrains"] }
    }
  ]
}
