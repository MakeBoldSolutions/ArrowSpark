---
import BaseLayout from './BaseLayout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import SpoilerGate from '../components/site/SpoilerGate.astro';
import Icon from '../components/ui/Icon.astro';

interface Props {
  title: string;
  description: string;
  part: number;
  spoiler: boolean;
  sources: { label: string; url: string }[];
  previous?: { title: string; slug: string } | undefined;
  next?: { title: string; slug: string } | undefined;
}
const { title, description, part, spoiler, sources, previous, next } = Astro.props;
---
<BaseLayout title={title} description={description} current="story">
  <article class="page article">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/story/">Read the Story</a><span aria-hidden="true">/</span><span>Part {part}</span></nav>
    <Eyebrow>Part {part} of 9</Eyebrow>
    <h1 class="article__title">{title}</h1>
    <p class="article__description">{description}</p>
    {spoiler && <SpoilerGate />}
    <div class="prose">
      <slot />
    </div>
    {sources.length > 0 && (
      <aside class="article__sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading">Sources</h2>
        <ul>
          {sources.map((source) => <li><a href={source.url}>{source.label}</a></li>)}
        </ul>
      </aside>
    )}
    <nav class="article__pager" aria-label="Chapters">
      {previous ? <a href={`/story/${previous.slug}/`}>Previous: {previous.title}</a> : <span></span>}
      {next ? <a href={`/story/${next.slug}/`}>Next: {next.title} <Icon name="arrow-right" /></a> : <a href="/play/">Now play it <Icon name="arrow-right" /></a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .article { max-width: var(--container-prose); padding-block: var(--space-10) var(--space-16); }
  .crumbs { display: flex; gap: var(--space-2); font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--text-muted); margin-bottom: var(--space-6); }
  .article__title { font-size: var(--fs-h1); color: var(--brand); margin-top: var(--space-3); }
  .article__description { font-size: var(--fs-lg); color: var(--ink-700); margin-bottom: var(--space-8); }
  .prose { font-size: var(--fs-lg); line-height: var(--lh-relaxed); }
  .prose :global(h2) { font-size: var(--fs-h3); margin: var(--space-12) 0 var(--space-4); }
  .prose :global(h3) { font-size: var(--fs-xl); margin: var(--space-8) 0 var(--space-3); }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 var(--space-5); }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
    border-left: var(--border-accent) solid var(--accent);
    color: var(--ink-700);
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); margin: var(--space-6) 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: var(--space-2) var(--space-3); border-bottom: var(--border-hairline) solid var(--border-default); }
  .prose :global(pre) { background: var(--surface-dark); color: var(--cream); padding: var(--space-4); border-radius: var(--radius-md); overflow-x: auto; font-size: var(--fs-sm); }
  .prose :global(hr) { margin: var(--space-12) 0; }
  .article__sources { margin-top: var(--space-12); padding-top: var(--space-6); border-top: var(--border-hairline) solid var(--border-default); }
  .article__sources h2 { font-size: var(--fs-xl); }
  .article__pager { margin-top: var(--space-10); display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; font-weight: var(--fw-semibold); }
  .article__pager a { display: inline-flex; align-items: center; gap: var(--space-2); }
</style>
