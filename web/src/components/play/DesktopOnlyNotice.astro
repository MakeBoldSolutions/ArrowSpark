---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const playUrl = 'https://arrow.makeboldspark.com/play/';
const mailto = `mailto:?subject=${encodeURIComponent('ArrowSpark: try it on a desktop')}&body=${encodeURIComponent(playUrl)}`;
---
<div class="desktop-only" role="note">
  <p class="desktop-only__title">ArrowSpark is designed for desktop browsers.</p>
  <p class="desktop-only__text">
    It needs a mouse or trackpad, a keyboard and a screen at least 960 × 540. Play on this device isn’t supported yet.
    The story of how it was built works anywhere.
  </p>
  <div class="desktop-only__actions">
    <Button href="/devspark/">Read how it was built</Button>
    <Button variant="secondary" type="button" data-copy-link={playUrl}><Icon name="copy" /><span>Copy the link</span></Button>
    <Button variant="secondary" href={mailto}><Icon name="mail" /><span>Email myself the link</span></Button>
  </div>
  <p class="desktop-only__status" data-copy-status aria-live="polite"></p>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  button?.addEventListener('click', () => {
    const url = button.dataset.copyLink ?? '';
    navigator.clipboard
      ?.writeText(url)
      .then(() => {
        if (status) status.textContent = 'Link copied.';
      })
      .catch(() => {
        if (status) status.textContent = `Copy this link: ${url}`;
      });
  });
</script>

<style>
  .desktop-only {
    display: none;
    background: var(--surface-card);
    border: var(--border-hairline) solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--space-10) var(--space-6);
    text-align: center;
  }
  .desktop-only__title {
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: var(--fs-2xl);
    line-height: var(--lh-snug);
    color: var(--text-strong);
    margin: 0;
  }
  .desktop-only__text { max-width: 46ch; margin: var(--space-3) auto 0; }
  .desktop-only__actions { margin-top: var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }
  .desktop-only__status { margin-top: var(--space-3); font-size: var(--fs-sm); color: var(--text-muted); min-height: 1lh; }

  @media not all and (pointer: fine), (max-width: 59.9375rem), (max-height: 33.6875rem) {
    .desktop-only { display: block; }
  }
</style>
